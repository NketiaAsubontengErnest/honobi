// ============================================================
// HONOBI WOOD JOINERY - Complete Prisma Schema
// Carpenter Shop Website & Business Management System
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==================== ENUMS ====================

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  SECRETARY
  ACCOUNTANT
  STAFF
}

enum ProductStatus {
  AVAILABLE
  OUT_OF_STOCK
  MADE_TO_ORDER
  DISCONTINUED
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum JobStatus {
  PENDING
  APPROVED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  DELIVERED
  CANCELLED
}

enum QuoteStatus {
  PENDING
  APPROVED
  REJECTED
  CONVERTED
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  MTN_MOMO
  TELECEL_CASH
  AIRTELTIGO_MONEY
  BANK_TRANSFER
  CARD
  OTHER
}

enum IncomeCategory {
  FURNITURE_SALES
  CARPENTRY_SERVICES
  INSTALLATION
  REPAIRS
  DELIVERY
  CUSTOM_ORDERS
  OTHER
}

enum ExpenseCategory {
  WOOD
  PLYWOOD
  MDF
  NAILS
  SCREWS
  GLUE
  PAINT
  VARNISH
  SANDPAPER
  HARDWARE
  ELECTRICITY
  WATER
  RENT
  TRANSPORT
  FUEL
  SALARIES
  TOOLS
  MACHINE_MAINTENANCE
  REPAIRS
  MARKETING
  INTERNET
  PACKAGING
  DELIVERY
  OTHER
}

enum StockMovementType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
}

enum NotificationType {
  QUOTE_REQUEST
  CONTACT_MESSAGE
  LOW_INVENTORY
  OUTSTANDING_PAYMENT
  JOB_DUE
  NEW_CUSTOMER
  NEW_INCOME
  NEW_EXPENSE
  PAYMENT_RECEIVED
  INVOICE_GENERATED
}

enum MessageStatus {
  NEW
  READ
  REPLIED
  CLOSED
}

enum EmployeePosition {
  CARPENTER
  ASSISTANT_CARPENTER
  FINISHING_SPECIALIST
  INSTALLER
  DRIVER
  STOREKEEPER
  ACCOUNTANT
  MANAGER
  ADMINISTRATOR
}

enum InventoryUnit {
  PIECES
  SHEETS
  METERS
  LITRES
  KILOGRAMS
  BOXES
  SETS
}

enum CuttingPlanStatus {
  DRAFT
  GENERATED
  APPROVED
  PRINTED
  COMPLETED
  ARCHIVED
}

enum BoardMaterialType {
  MDF
  PLYWOOD
  HARDWOOD
  SOFTWOOD
  MELAMINE
  CHIPBOARD
  VENEER
  LAMINATED
  CUSTOM
}

enum CuttingDirectionMode {
  HORIZONTAL
  VERTICAL
  AUTOMATIC
}

enum GrainDirection {
  NONE
  LENGTH
  WIDTH
}

enum CuttingStrategy {
  GUILLOTINE
  NESTING_2D
}

enum PayrollCycle {
  DAILY
  WEEKLY
  MONTHLY
}

enum PayrollRunStatus {
  PENDING
  PROCESSED
  PAID
  CANCELLED
}

// ==================== AUTHENTICATION & USERS ====================

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String
  role          Role      @default(STAFF)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  customer      Customer?
  jobs          Job[]         @relation("AssignedEmployee")
  income        Income[]
  expenses      Expense[]
  payments      Payment[]
  notifications Notification[]
  auditLogs     AuditLog[]
  media         Media[]
  cuttingPlans      CuttingPlan[]
  boardPresets      BoardPreset[]
  payrollRuns       PayrollRun[]

  @@index([email])
  @@index([role])
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==================== CUSTOMERS ====================

model Customer {
  id              String    @id @default(uuid())
  userId          String?   @unique
  name            String
  phone           String
  altPhone        String?
  email           String?
  address         String?
  city            String?
  region          String?
  notes           String?   @db.Text
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  userIdFK        String?   @unique
  user            User?     @relation(fields: [userIdFK], references: [id])
  jobs            Job[]
  quotes          Quote[]
  invoices        Invoice[]
  payments        Payment[]
  income          Income[]
  testimonials    Testimonial[]

  @@index([name])
  @@index([phone])
  @@index([email])
}

// ==================== PRODUCTS ====================

model ProductCategory {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  description String? @db.Text
  image     String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@index([slug])
}

model Product {
  id            String        @id @default(uuid())
  name          String
  slug          String        @unique
  description   String?       @db.Text
  price         Decimal       @db.Decimal(12, 2)
  discountedPrice Decimal?    @db.Decimal(12, 2)
  sku           String?       @unique
  dimensions    String?
  materials     String?
  color         String?
  availability  String?
  status        ProductStatus @default(AVAILABLE)
  isFeatured    Boolean       @default(false)
  isPublic      Boolean       @default(true)
  showPrice     Boolean       @default(false)
  categoryId    String?
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  category      ProductCategory? @relation(fields: [categoryId], references: [id])
  images        ProductImage[]

  @@index([slug])
  @@index([status])
  @@index([isFeatured])
  @@index([categoryId])
}

model ProductImage {
  id        String  @id @default(uuid())
  url       String
  altText   String?
  productId String
  order     Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// ==================== PROJECTS ====================

model ProjectCategory {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  description String? @db.Text
  image     String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  projects  Project[]

  @@index([slug])
}

model Project {
  id              String        @id @default(uuid())
  name            String
  slug            String        @unique
  description     String?       @db.Text
  customerName    String?
  location        String?
  startDate       DateTime?
  completionDate  DateTime?
  budget          Decimal?      @db.Decimal(12, 2)
  status          ProjectStatus @default(PLANNING)
  coverImage      String?
  materialsUsed   String?       @db.Text
  servicesPerformed String?     @db.Text
  isFeatured      Boolean       @default(false)
  isPublic        Boolean       @default(true)
  categoryId      String?
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  category        ProjectCategory? @relation(fields: [categoryId], references: [id])
  images          ProjectImage[]
  jobs            Job[]
  cuttingPlans    CuttingPlan[]

  @@index([slug])
  @@index([status])
  @@index([isFeatured])
  @@index([categoryId])
}

model ProjectImage {
  id        String  @id @default(uuid())
  url       String
  altText   String?
  projectId String
  order     Int     @default(0)
  isBeforeAfter Boolean @default(false)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// ==================== SERVICES ====================

model ServiceCategory {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  description String? @db.Text
  image     String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  services  Service[]

  @@index([slug])
}

model Service {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String? @db.Text
  image       String?
  icon        String?
  isFeatured  Boolean @default(false)
  isPublic    Boolean @default(true)
  order       Int     @default(0)
  categoryId  String?
  isActive    Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category    ServiceCategory? @relation(fields: [categoryId], references: [id])

  @@index([slug])
  @@index([isFeatured])
}

// ==================== QUOTATIONS ====================

model Quote {
  id              String      @id @default(uuid())
  quoteNumber     String      @unique
  customerId      String?
  customerName    String?
  phone           String?
  email           String?
  location        String?
  projectType     String?
  description     String?     @db.Text
  estimatedBudget Decimal?    @db.Decimal(12, 2)
  preferredDate   DateTime?
  attachments     String?
  additionalNotes String?     @db.Text
  status          QuoteStatus @default(PENDING)
  totalAmount     Decimal?    @db.Decimal(12, 2)
  isValid         Boolean     @default(true)
  createdBy       String?
  convertedJobId  String?   @unique
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  customer        Customer?   @relation(fields: [customerId], references: [id])
  items           QuoteItem[]
  convertedJob    Job?        @relation("QuoteToJob", fields: [convertedJobId], references: [id])

  @@index([status])
  @@index([customerId])
  @@index([quoteNumber])
}

model QuoteItem {
  id          String  @id @default(uuid())
  quoteId     String
  name        String
  description String?
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(12, 2)
  totalPrice  Decimal @db.Decimal(12, 2)
  category    String? // labour, materials, delivery, installation, other

  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
}

// ==================== JOBS ====================

model Job {
  id                  String    @id @default(uuid())
  jobNumber           String    @unique
  customerId          String
  title               String
  description         String?   @db.Text
  projectId           String?
  assignedTo          String?
  startDate           DateTime?
  expectedCompletion  DateTime?
  actualCompletion    DateTime?
  estimatedCost       Decimal?  @db.Decimal(12, 2)
  finalCost           Decimal?  @db.Decimal(12, 2)
  amountPaid          Decimal   @default(0) @db.Decimal(12, 2)
  balance             Decimal   @default(0) @db.Decimal(12, 2)
  status              JobStatus @default(PENDING)
  notes               String?   @db.Text
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  customer            Customer    @relation(fields: [customerId], references: [id])
  project             Project?    @relation(fields: [projectId], references: [id])
  employee            User?       @relation("AssignedEmployee", fields: [assignedTo], references: [id])
  items               JobItem[]
  invoices            Invoice[]
  payments            Payment[]
  quoteSource         Quote?      @relation("QuoteToJob")
  cuttingPlans        CuttingPlan[]

  @@index([status])
  @@index([customerId])
  @@index([jobNumber])
}

model JobItem {
  id        String  @id @default(uuid())
  jobId     String
  name      String
  description String?
  quantity  Int     @default(1)
  unitPrice Decimal @db.Decimal(12, 2)
  totalPrice Decimal @db.Decimal(12, 2)

  job       Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

// ==================== INVOICES ====================

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique
  customerId    String
  jobId         String?
  items         InvoiceItem[]
  subtotal      Decimal       @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  taxRate       Decimal       @default(0) @db.Decimal(5, 2)
  taxAmount     Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  amountPaid    Decimal       @default(0) @db.Decimal(12, 2)
  balance       Decimal       @default(0) @db.Decimal(12, 2)
  status        InvoiceStatus @default(DRAFT)
  dueDate       DateTime?
  notes         String?       @db.Text
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  customer      Customer      @relation(fields: [customerId], references: [id])
  job           Job?          @relation(fields: [jobId], references: [id])
  payments      Payment[]

  @@index([status])
  @@index([customerId])
  @@index([invoiceNumber])
}

model InvoiceItem {
  id        String  @id @default(uuid())
  invoiceId String
  name      String
  description String?
  quantity  Int     @default(1)
  unitPrice Decimal @db.Decimal(12, 2)
  totalPrice Decimal @db.Decimal(12, 2)

  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

// ==================== PAYMENTS ====================

model Payment {
  id              String        @id @default(uuid())
  reference       String        @unique
  customerId      String
  invoiceId       String?
  jobId           String?
  amount          Decimal       @db.Decimal(12, 2)
  paymentDate     DateTime      @default(now())
  paymentMethod   PaymentMethod
  notes           String?
  recordedById    String?
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  customer        Customer      @relation(fields: [customerId], references: [id])
  invoice         Invoice?      @relation(fields: [invoiceId], references: [id])
  job             Job?          @relation(fields: [jobId], references: [id])
  recordedBy      User?         @relation(fields: [recordedById], references: [id])

  @@index([customerId])
  @@index([invoiceId])
  @@index([reference])
}

// ==================== INCOME ====================

model Income {
  id              String          @id @default(uuid())
  incomeNumber    String          @unique
  date            DateTime
  amount          Decimal         @db.Decimal(12, 2)
  customerId      String?
  jobId           String?
  paymentMethod   PaymentMethod
  category        IncomeCategory
  description     String?
  reference       String?
  recordedById    String?
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  customer        Customer?       @relation(fields: [customerId], references: [id])
  recordedBy      User?           @relation(fields: [recordedById], references: [id])

  @@index([date])
  @@index([category])
  @@index([customerId])
}

// ==================== EXPENSES ====================

model Supplier {
  id            String    @id @default(uuid())
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  materials     String?
  notes         String?   @db.Text
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  expenses      Expense[]
  inventoryItems InventoryItem[]
  cuttingPlans  CuttingPlan[]

  @@index([name])
}

model Expense {
  id              String          @id @default(uuid())
  expenseNumber   String          @unique
  date            DateTime
  amount          Decimal         @db.Decimal(12, 2)
  category        ExpenseCategory
  supplierId      String?
  description     String?
  paymentMethod   PaymentMethod
  reference       String?
  receipt         String?
  recordedById    String?
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  supplier        Supplier?       @relation(fields: [supplierId], references: [id])
  recordedBy      User?           @relation(fields: [recordedById], references: [id])

  @@index([date])
  @@index([category])
  @@index([supplierId])
}

// ==================== INVENTORY ====================

model InventoryCategory {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  items     InventoryItem[]

  @@index([slug])
}

model InventoryItem {
  id            String          @id @default(uuid())
  name          String
  sku           String?         @unique
  categoryId    String?
  unit          InventoryUnit
  quantity      Decimal         @default(0) @db.Decimal(12, 2)
  minStock      Decimal         @default(0) @db.Decimal(12, 2)
  costPerUnit   Decimal         @default(0) @db.Decimal(12, 2)
  supplierId    String?
  location      String?
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  category      InventoryCategory? @relation(fields: [categoryId], references: [id])
  supplier      Supplier?          @relation(fields: [supplierId], references: [id])
  movements     StockMovement[]

  @@index([sku])
  @@index([categoryId])
  @@index([quantity])
}

model StockMovement {
  id            String              @id @default(uuid())
  itemId        String
  type          StockMovementType
  quantity      Decimal             @db.Decimal(12, 2)
  unitCost      Decimal?            @db.Decimal(12, 2)
  reference     String?
  notes         String?
  performedById String?
  createdAt     DateTime            @default(now())

  item          InventoryItem       @relation(fields: [itemId], references: [id])

  @@index([itemId])
  @@index([type])
  @@index([createdAt])
}

// ==================== EMPLOYEES ====================

model Employee {
  id                String            @id @default(uuid())
  employeeId        String            @unique
  name              String
  phone             String?
  email             String?
  position          EmployeePosition
  salary            Decimal?          @db.Decimal(12, 2)
  hireDate          DateTime?
  status            String            @default("ACTIVE")
  address           String?
  emergencyContact  String?
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  salaryPayments    SalaryPayment[]
  payrollConfigs    PayrollConfig[]
  payrollRuns       PayrollRun[]

  @@index([employeeId])
  @@index([position])
}

model SalaryPayment {
  id            String    @id @default(uuid())
  employeeId    String
  amount        Decimal   @db.Decimal(12, 2)
  date          DateTime
  type          String    // salary, advance, bonus, deduction
  period        String?   // e.g., "2024-01"
  notes         String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  employee      Employee  @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([date])
  @@index([type])
}

// ==================== PAYROLL ====================

model PayrollConfig {
  id           String        @id @default(uuid())
  employeeId   String
  cycle        PayrollCycle  @default(MONTHLY)
  // Base pay for the cycle unit: per day / per week / per month
  baseRate     Decimal       @db.Decimal(12, 2)
  allowance    Decimal?      @db.Decimal(12, 2)
  deduction    Decimal?      @db.Decimal(12, 2)
  effectiveFrom DateTime     @default(now())
  notes        String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  employee     Employee      @relation(fields: [employeeId], references: [id])

  @@unique([employeeId])
  @@index([cycle])
}

model PayrollRun {
  id           String          @id @default(uuid())
  runNumber    String          @unique
  employeeId   String
  cycle        PayrollCycle
  periodStart  DateTime
  periodEnd    DateTime
  daysWorked   Decimal         @default(0) @db.Decimal(8, 2)
  baseAmount   Decimal         @db.Decimal(12, 2)
  allowance    Decimal         @default(0) @db.Decimal(12, 2)
  deduction    Decimal         @default(0) @db.Decimal(12, 2)
  netAmount    Decimal         @db.Decimal(12, 2)
  status       PayrollRunStatus @default(PENDING)
  paidDate     DateTime?
  paymentId    String?         // linked SalaryPayment once marked paid
  notes        String?
  createdById  String?
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  employee     Employee        @relation(fields: [employeeId], references: [id])
  createdBy    User?           @relation(fields: [createdById], references: [id])

  @@index([employeeId])
  @@index([status])
  @@index([periodStart])
  @@index([cycle])
}

// ==================== TESTIMONIALS ====================

model Testimonial {
  id              String    @id @default(uuid())
  customerName    String
  customerRole    String?
  testimonial     String    @db.Text
  customerImage   String?
  rating          Int       @default(5)
  isFeatured      Boolean   @default(false)
  isApproved      Boolean   @default(false)
  isPublic        Boolean   @default(true)
  customerId      String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  customer        Customer? @relation(fields: [customerId], references: [id])

  @@index([isFeatured])
  @@index([isApproved])
}

// ==================== CONTACT MESSAGES ====================

model ContactMessage {
  id        String        @id @default(uuid())
  name      String
  email     String?
  phone     String?
  subject   String?
  message   String        @db.Text
  source    String?       // website, social, phone
  status    MessageStatus @default(NEW)
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
}

// ==================== NOTIFICATIONS ====================

model Notification {
  id        String           @id @default(uuid())
  userId    String?
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  user      User?            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

// ==================== MEDIA ====================

model Media {
  id          String    @id @default(uuid())
  url         String
  filename    String
  mimeType    String
  size        Int?
  altText     String?
  uploadedById String?
  folder      String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  uploadedBy  User?     @relation(fields: [uploadedById], references: [id])

  @@index([folder])
  @@index([createdAt])
}

// ==================== SETTINGS ====================

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String   @db.Text
  type      String   @default("string") // string, number, boolean, json
  group     String   @default("general") // general, business, invoice, social, hours
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
  @@index([group])
}

// ==================== AUDIT LOG ====================

model AuditLog {
  id        String    @id @default(uuid())
  userId    String?
  action    String    // CREATE, UPDATE, DELETE, LOGIN, LOGOUT, PAYMENT, etc.
  entity    String
  entityId  String?
  metadata  Json?
  ipAddress String?
  createdAt DateTime  @default(now())

  user      User?     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity])
  @@index([action])
  @@index([createdAt])
}

// ==================== CUTTING OPTIMIZER ====================

model CuttingPlan {
  id              String              @id @default(uuid())
  planNumber      String              @unique
  name            String
  status          CuttingPlanStatus   @default(DRAFT)

  // Links
  projectId       String?
  jobId           String?
  supplierId      String?
  customerName    String?

  // Stock board / sheet settings
  materialName    String
  materialType    BoardMaterialType   @default(MDF)
  boardLength     Decimal             @db.Decimal(10, 2)
  boardWidth      Decimal             @db.Decimal(10, 2)
  boardThickness  Decimal?            @db.Decimal(10, 2)
  boardQuantity   Int                 @default(1)
  unit            String              @default("mm")
  boardPrice      Decimal?            @db.Decimal(12, 2)
  notes           String?             @db.Text

  // Cutting settings
  kerf            Decimal             @default(3) @db.Decimal(6, 2)
  trimTop         Decimal             @default(0) @db.Decimal(6, 2)
  trimBottom      Decimal             @default(0) @db.Decimal(6, 2)
  trimLeft        Decimal             @default(0) @db.Decimal(6, 2)
  trimRight       Decimal             @default(0) @db.Decimal(6, 2)
  direction       CuttingDirectionMode @default(AUTOMATIC)
  allowRotation   Boolean             @default(true)
  grainStrategy   GrainDirection      @default(NONE)
  strategy        CuttingStrategy     @default(GUILLOTINE)

  // Generated optimization results
  boardsUsed      Int?
  totalPieceArea  Decimal?            @db.Decimal(14, 2)
  totalBoardArea  Decimal?            @db.Decimal(14, 2)
  wasteArea       Decimal?            @db.Decimal(14, 2)
  efficiency      Decimal?            @db.Decimal(5, 2)   // percentage 0-100
  layout          Json?               // per-board placements for diagram
  cutSequence     Json?               // ordered guillotine cuts per board
  unplacedPieces  Json?               // pieces that did not fit
  generatedAt     DateTime?

  createdById     String?
  isActive        Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  project         Project?            @relation(fields: [projectId], references: [id])
  job             Job?                @relation(fields: [jobId], references: [id])
  supplier        Supplier?           @relation(fields: [supplierId], references: [id])
  createdBy       User?               @relation(fields: [createdById], references: [id])
  pieces          CuttingPiece[]

  @@index([status])
  @@index([projectId])
  @@index([jobId])
  @@index([planNumber])
}

model CuttingPiece {
  id            String          @id @default(uuid())
  planId        String
  name          String
  length        Decimal         @db.Decimal(10, 2)
  width         Decimal         @db.Decimal(10, 2)
  quantity      Int             @default(1)
  thickness     Decimal?        @db.Decimal(10, 2)
  grain         GrainDirection  @default(NONE)
  allowRotation Boolean         @default(true)
  notes         String?
  // Edge banding per side (name/code of the band, empty = no band)
  edgeTop       String?
  edgeBottom    String?
  edgeLeft      String?
  edgeRight     String?
  order         Int             @default(0)

  plan          CuttingPlan     @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
}

model BoardPreset {
  id            String            @id @default(uuid())
  name          String            @unique
  materialType  BoardMaterialType @default(MDF)
  length        Decimal           @db.Decimal(10, 2)
  width         Decimal           @db.Decimal(10, 2)
  thickness     Decimal?          @db.Decimal(10, 2)
  unit          String            @default("mm")
  isDefault     Boolean           @default(false)
  createdById   String?
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  createdBy     User?             @relation(fields: [createdById], references: [id])

  @@index([name])
}
